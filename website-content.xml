    <section id="schedule" type="content">

      <day label="Day 1 — Thursday 28th April">
        <slot type="logistics" time="09:00 – 11:15">Arrival</slot>
        <slot type="talk" time="11:15 – 12:15">
          <title>Why I Care about Proof-theoretic Semantics</title>
          <speaker><link href="http://www0.cs.ucl.ac.uk/staff/D.Pym/">David J. Pym</link></speaker>
        </slot>
        <slot type="talk" time="12:15 – 13:00">
